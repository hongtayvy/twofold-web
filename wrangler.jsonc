// Cloudflare deploy config. The site is static files, so this is an assets-only
// Worker: no server code, Cloudflare serves whatever is in ./site.
// Deployed by Cloudflare's Git integration on every push to master (`npx wrangler deploy`).
{
  "name": "twofold-web",
  "compatibility_date": "2026-09-01",
  // twofoldfinance.com is the only public address. Without this line every deploy
  // turns the twofold-web.<account>.workers.dev address back on.
  "workers_dev": false,
  // Per-branch preview URLs stay on so a branch can be checked before it merges.
  "preview_urls": true,
  "assets": {
    "directory": "./site"
  }
}
